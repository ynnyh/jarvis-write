{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jarvis-write",
  "version": "0.1.0",
  "identifier": "com.jarviswrite.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": ["SimpChinese"]
      }
    },
    "resources": {
      "../backend/dist/jarvis-write-backend": "jarvis-write-backend"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ynnyh/jarvis-write/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1Mjc0Qzc1NTk4MDhBRQpSV1N1Q0poVngzUlNENVhEV2RybklTdFlHdGx1VG9JeWZ0UG12YjNWSk4vbTF5N3NKK3lGRGVZcQo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
