{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jarvis-write",
  "version": "0.1.0",
  "identifier": "com.jarviswrite.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/dist/jarvis-write-backend": "jarvis-write-backend"
    }
  }
}
