# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# 运行时数据(本地私有,不入库)
backend/jarvis_write.db
backend/jarvis_write.db-shm
backend/jarvis_write.db-wal
backend/chroma_data/
backend/.env
backend/app.log
backend/server.log

# Node
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# 文档站(VitePress)构建产物,不入库
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# 压测/运行产物
backend/scripts/stress_report.jsonl

# 桌面版构建产物(PyInstaller + Tauri,体积大,不入库)
backend/build/
backend/dist/
# 打包时由 CI/build 脚本写入的版本文件(供冻结后读回设 APP_VERSION),非源码
backend/_version.txt
src-tauri/target/
src-tauri/gen/
# Tauri 图标由 `tauri icon` 从 icon-source.png 现场生成,不入库
src-tauri/icons/
# 更新签名私钥(本地构建用,严禁入库!)
src-tauri/updater.key

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Tauri 构建期自动生成的命令权限(标记 DO NOT EDIT,每次构建重建)
src-tauri/permissions/autogenerated/
